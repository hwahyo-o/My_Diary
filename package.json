{
  "name": "my-diary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:dist-security": "node scripts/verify-dist-security.mjs dist",
    "verify:ci-security": "node scripts/verify-ci-security.mjs",
    "verify:sw-release": "node scripts/verify-sw-release.mjs public/sw.js",
    "release:gate": "node scripts/release-gate.mjs",
    "verify:pages": "node scripts/verify-pages-deployment.mjs dist",
    "release:manifest": "node scripts/release-manifest.mjs dist"
  },
  "dependencies": {
    "hash-wasm": "4.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^27.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
